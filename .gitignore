# --- ESP-IDF build output (regenerated by idf.py) ---
build/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock

# --- audio is deliberately NOT in this repo ---------------------------------
# The countdown clips are a personal voice recording, and the original reward
# sounds are Disney-derived and not ours to redistribute. See the README.
# Put your own recordings in assets/audio-src/ and run tools\build-audio.ps1;
# they stay out of git. firmware/spiffs audio is generated from those masters,
# so it's ignored too - see firmware/spiffs/README.md.
assets/audio-src/
firmware/spiffs/**/*.wav
firmware/spiffs/**/*.mp3

# --- OTA staging (generated by tools/release.ps1) ---
release/

# --- OS cruft ---
Thumbs.db
.DS_Store
~$*
